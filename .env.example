# Copy to .env (never commit it). Every variable is optional.
TAG_PROVIDER=ollama                 # ollama | anthropic | fake
TAG_MODEL=qwen3:4b                  # claude-sonnet-5-5 for anthropic
OLLAMA_HOST=http://127.0.0.1:11434  # loopback only unless the next line is 1
TAG_ALLOW_REMOTE_OLLAMA=
TAG_TEMPERATURE=0
TAG_DB=                             # a SQLite file; default: the bundled movies database
TAG_TABLES=                         # comma-separated allowlist for TAG_DB
TAG_HIDDEN_COLUMNS=                 # comma-separated table.column entries never exposed
TAG_MAX_ROWS=100
TAG_TIMEOUT=2
TAG_MAX_LM_ROWS=60
TAG_MAX_LM_CALLS=120
TAG_MAX_CONCURRENCY=4
TAG_MAX_TOOL_CALLS=12
TAG_ANSWER_ROWS=30
TAG_SCHEMA_SAMPLES=0                # >0 puts real rows in the schema prompt (opt-in)
TAG_RAG_K=10
# Only for the optional Anthropic adapter (pip install ".[anthropic]"):
# ANTHROPIC_API_KEY=
